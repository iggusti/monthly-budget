# Telegram credentials are never shipped to the browser. They live as GitHub
# repository secrets used by .github/workflows/push-notifications.yml:
#
#   TELEGRAM_BOT_TOKEN           token from @BotFather
#   TELEGRAM_CHAT_ID             shared fallback chat
#   TELEGRAM_CHAT_ID_HUSBAND     husband's Telegram user id
#   TELEGRAM_CHAT_ID_WIFE        wife's Telegram user id
#
# The Firebase service account secret
# (FIREBASE_SERVICE_ACCOUNT_MONTHLY_BUDGET_580B2) already exists in the repo.
