# Pushover credentials are never shipped to the browser. They live as GitHub
# repository secrets used by .github/workflows/push-notifications.yml:
#
#   PUSHOVER_APP_TOKEN           application token from pushover.net/apps/build
#   PUSHOVER_USER_KEY            one key for the whole family (simple setup), OR
#   PUSHOVER_USER_KEY_HUSBAND    per-person keys so the editor is skipped
#   PUSHOVER_USER_KEY_WIFE
#
# The Firebase service account secret
# (FIREBASE_SERVICE_ACCOUNT_MONTHLY_BUDGET_580B2) already exists in the repo.
