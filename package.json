{
	"name": "monthly-budget",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
		"test:watch": "vitest",
		"verify": "npm run check && npm run lint && npm test"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^9.39.5",
		"globals": "^15.15.0",
		"sharp": "^0.35.5",
		"svelte": "^5.59.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"date-fns": "^4.4.0",
		"firebase": "^12.9.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.9"
	},
	"overrides": {
		"@grpc/grpc-js": "^1.14.5"
	}
}
