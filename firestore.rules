rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /budget/{document} {
      // Only authenticated users (anonymous sign-in) can read/write.
      allow read, write: if request.auth != null;
    }

    // Push notification tokens, one document per device keyed by its FCM token.
    // A device may only manage its own entry; the Cloud Function reads these
    // through the Admin SDK (which bypasses these rules).
    match /devices/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
