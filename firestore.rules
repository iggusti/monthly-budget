// Changes to this file are deployed automatically by sender-rules.yml on push,
// without a manual approval step.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /budget/{document} {
      // Only authenticated users (anonymous sign-in) can read/write.
      allow read, write: if request.auth != null;
    }

    // Pushover registration, one document per browser keyed by its anonymous
    // uid. A device may only read and manage its own entry; the scheduled
    // sender reads these through the Admin SDK (which bypasses these rules).
    match /devices/{uid} {
      // `resource` is null for a get on a document that does not exist yet,
      // which is the normal first-run case for a fresh anonymous uid.
      allow get: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // One job per budget write. Clients only append; the scheduled sender
    // claims jobs and updates their status with the Admin SDK.
    match /notification-outbox/{job} {
      allow read, create, delete: if request.auth != null;
      allow update: if false;
    }
  }
}
